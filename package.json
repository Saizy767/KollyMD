{
  "name": "kollymd",
  "version": "0.1.0",
  "private": true,
  "description": "Local Obsidian-like knowledge base built on Electron + TypeScript",
  "main": "dist/main/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && if [ \"$(uname -s)\" = \"Darwin\" ]; then xattr -r -d com.apple.quarantine node_modules/electron/dist/Electron.app 2>/dev/null; codesign --force --deep --sign - node_modules/electron/dist/Electron.app 2>/dev/null; fi; true",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:deps": "node scripts/lint-usecase-deps.mjs",
    "lint:encapsulation": "node scripts/lint-module-encapsulation.mjs",
    "lint:domain": "node scripts/lint-domain-purity.mjs",
    "lint:arch": "npm run lint:deps && npm run lint:encapsulation && npm run lint:domain",
    "lint:style-css": "node scripts/lint-style-css-surface.mjs",
    "lint:style-assets": "node scripts/lint-style-assets.mjs",
    "lint:style-deps": "node scripts/lint-style-deps.mjs",
    "lint:style": "npm run lint:style-css && npm run lint:style-assets && npm run lint:style-deps",
    "new-module": "node scripts/new-module.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && vite build",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.12.12",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.4.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
